BasedOnStyle:   LLVM          # LLVM을 베이스로 필요 항목만 덮어쓰기
IndentWidth:    4             # 한 탭 = 4 스페이스
UseTab:         Never         # 탭 대신 스페이스
BreakBeforeBraces: Allman     # { 를 다음 줄로 (클래스·함수·네임스페이스 등)
AllowShortFunctionsOnASingleLine: Empty   # 빈 함수만 한 줄에 허용
ColumnLimit:    0             # 자동 줄바꿈 끔(긴 줄 그대로 유지)
